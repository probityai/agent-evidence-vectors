# Compiled binaries. The leading slash keeps the source command directory.
/aee-verify
cmd/aee-verify/aee-verify
*.test

# Python caches and Go coverage artifacts.
__pycache__/
*.pyc
*.cov

# Private tool state.
.humanizer/

# Regenerated build intermediates and temporary upstream snapshots.
.build/
.crosswalk-upstream/

# Private tool sidecars.
*.ledger.json
*.humanizer-ledger.json

# Generated site output.
_site/

# Rust and Python build output of the crates and packages. Scoped to those
# trees: corpus directories track files named build/ and conformance-report.json,
# and the wheel build skips anything this file ignores.
target/
.venv/
dist/
*.egg-info/
/crates/**/build/
/packages/**/build/
/crates/**/conformance-report.json
/packages/**/conformance-report.json
