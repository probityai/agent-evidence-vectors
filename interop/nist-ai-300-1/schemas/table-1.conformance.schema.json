{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Table 1: Dataset documentation template (conformance)",
 "$comment": "Generated by gen_vectors.py from templates.json and readings.json. Do not edit by hand.",
 "type": "object",
 "required": [
  "conformsTo",
  "fields"
 ],
 "additionalProperties": false,
 "properties": {
  "conformsTo": {
   "type": "string"
  },
  "conditions": {
   "type": "object",
   "additionalProperties": {
    "type": "boolean"
   }
  },
  "fields": {
   "$ref": "#/$defs/fieldMap"
  }
 },
 "allOf": [
  {
   "$comment": "rule:table-1/field-1/required",
   "properties": {
    "fields": {
     "required": [
      "1"
     ]
    }
   }
  },
  {
   "$comment": "rule:table-1/serialization/conforms-to",
   "properties": {
    "conformsTo": {
     "const": "NIST.AI.300-1.ipd:5.2"
    }
   }
  },
  {
   "$comment": "rule:table-1/serialization/populated",
   "properties": {
    "fields": {
     "$ref": "#/$defs/populatedMap"
    }
   }
  }
 ],
 "$defs": {
  "fieldMap": {
   "type": "object",
   "patternProperties": {
    "-\\(\\*\\)$": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/field"
     }
    }
   },
   "additionalProperties": {
    "$ref": "#/$defs/field"
   }
  },
  "field": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "content": true,
    "subfields": {
     "$ref": "#/$defs/fieldMap"
    }
   },
   "additionalProperties": false
  },
  "populatedMap": {
   "patternProperties": {
    "-\\(\\*\\)$": {
     "items": {
      "$ref": "#/$defs/populated"
     }
    }
   },
   "additionalProperties": {
    "$ref": "#/$defs/populated"
   }
  },
  "populated": {
   "anyOf": [
    {
     "required": [
      "content"
     ],
     "properties": {
      "content": {
       "not": {
        "enum": [
         null,
         "",
         [],
         {}
        ]
       }
      }
     }
    },
    {
     "required": [
      "subfields"
     ],
     "properties": {
      "subfields": {
       "minProperties": 1
      }
     }
    }
   ],
   "properties": {
    "subfields": {
     "$ref": "#/$defs/populatedMap"
    }
   }
  }
 }
}
