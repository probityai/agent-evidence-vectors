{
  "bomFormat": "CycloneDX",
  "specVersion": "1.6",
  "version": 1,
  "metadata": {
    "component": {
      "type": "application",
      "bom-ref": "acme-portal",
      "name": "acme-portal",
      "version": "4.2.0"
    }
  },
  "components": [
    {
      "type": "library",
      "bom-ref": "lib-http",
      "name": "http-client",
      "version": "2.1.0"
    },
    {
      "type": "library",
      "bom-ref": "lib-json",
      "name": "json-codec",
      "version": "1.9.3"
    }
  ],
  "dependencies": [
    {
      "ref": "acme-portal",
      "dependsOn": [
        "lib-http",
        "lib-json",
        "svc-assist"
      ]
    }
  ],
  "compositions": [
    {
      "bom-ref": "comp-own",
      "aggregate": "complete",
      "assemblies": [
        "lib-http",
        "lib-json"
      ]
    },
    {
      "bom-ref": "comp-assist",
      "aggregate": "unknown",
      "assemblies": [
        "svc-assist"
      ]
    }
  ],
  "services": [
    {
      "bom-ref": "svc-assist",
      "name": "assist-endpoint",
      "version": "1",
      "endpoints": [
        "https://api.example.com/assist"
      ]
    }
  ]
}
