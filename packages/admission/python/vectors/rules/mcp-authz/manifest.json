{
 "ruleSet": "mcp-authz",
 "options": {
  "resource": "https://mcp.example.com/mcp",
  "issuers": [
   "https://as.example.com"
  ],
  "tokenEndpoints": [
   "https://as.example.com/token"
  ],
  "now": 1800000000
 },
 "cases": [
  {
   "id": "valid",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "admit"
   },
   "rationale": "issued by the advertised server for this resource, in its lifetime"
  },
  {
   "id": "aud-array",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":[\"https://other.example\",\"https://mcp.example.com/mcp\"],\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "admit"
   },
   "rationale": "an audience array that names this resource"
  },
  {
   "id": "aud-wrong",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://other.example/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "aud-mismatch"
   },
   "rationale": "a token for another resource"
  },
  {
   "id": "aud-missing",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "aud-missing"
   },
   "rationale": "no audience at all"
  },
  {
   "id": "aud-empty-array",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":[],\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "aud-missing"
   },
   "rationale": "an empty audience array"
  },
  {
   "id": "aud-token-endpoint",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://as.example.com/token\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "aud-is-token-endpoint"
   },
   "rationale": "the audience is the authorization server's token endpoint (the audience-injection class)"
  },
  {
   "id": "aud-trailing-slash",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp/\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "aud-matches-only-after-normalization"
   },
   "rationale": "equal only after a trailing slash is dropped"
  },
  {
   "id": "aud-case",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"HTTPS://MCP.EXAMPLE.COM/MCP\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "aud-matches-only-after-normalization"
   },
   "rationale": "equal only after case folding"
  },
  {
   "id": "iss-wrong",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://evil.example\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "iss-not-advertised"
   },
   "rationale": "an issuer the resource does not advertise"
  },
  {
   "id": "iss-missing",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "iss-missing"
   },
   "rationale": "no issuer"
  },
  {
   "id": "resource-wrong",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990,\"resource\":\"https://other.example/mcp\"},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "resource-mismatch"
   },
   "rationale": "a resource indicator for another server"
  },
  {
   "id": "resource-right",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990,\"resource\":\"https://mcp.example.com/mcp\"},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "admit"
   },
   "rationale": "a resource indicator naming this server"
  },
  {
   "id": "expired",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1799999940,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "token-expired"
   },
   "rationale": "exp plus the skew tolerance has passed"
  },
  {
   "id": "expiry-inside-skew",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1799999941,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "admit"
   },
   "rationale": "exp passed by less than the skew tolerance"
  },
  {
   "id": "exp-missing",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "exp-missing"
   },
   "rationale": "no expiry"
  },
  {
   "id": "exp-fraction",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000000.5,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "time-member-malformed"
   },
   "rationale": "a NumericDate that is not an integer"
  },
  {
   "id": "exp-unsafe",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":9007199254740993,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "unsafe-integer"
   },
   "rationale": "an expiry past 2^53"
  },
  {
   "id": "not-yet-valid",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990,\"nbf\":1800000061},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "token-not-yet-valid"
   },
   "rationale": "nbf past now plus the skew"
  },
  {
   "id": "issued-in-future",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1800000061},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "iat-in-future"
   },
   "rationale": "iat past now plus the skew"
  },
  {
   "id": "dpop-as-bearer",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990,\"cnf\":{\"jkt\":\"0ZcOCORZNYy-DWpqq30jZyJGHTN0d2HglBV3uiguA4I\"}},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "bound-token-as-bearer"
   },
   "rationale": "a DPoP-bound token presented as a bearer token"
  },
  {
   "id": "dpop-as-dpop",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990,\"cnf\":{\"jkt\":\"0ZcOCORZNYy-DWpqq30jZyJGHTN0d2HglBV3uiguA4I\"}},\"presentation\":\"dpop\"}",
   "expect": {
    "verdict": "admit"
   },
   "rationale": "the bound token presented with DPoP"
  },
  {
   "id": "id-jag",
   "text": "{\"header\":{\"typ\":\"oauth-id-jag+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990,\"resource\":\"https://mcp.example.com/mcp\"},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "id-jag-at-resource"
   },
   "rationale": "an identity assertion grant presented to a resource server"
  },
  {
   "id": "id-jag-wrong-resource",
   "text": "{\"header\":{\"typ\":\"oauth-id-jag+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990,\"resource\":\"https://other.example/mcp\"},\"presentation\":\"bearer\"}",
   "expect": {
    "verdict": "refuse",
    "code": "resource-mismatch"
   },
   "rationale": "an identity assertion grant for another resource"
  },
  {
   "id": "no-presentation",
   "text": "{\"header\":{\"typ\":\"at+jwt\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990}}",
   "expect": {
    "verdict": "refuse",
    "code": "token-shape-malformed"
   },
   "rationale": "how the token was presented is part of the decision"
  },
  {
   "id": "no-clock",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "options": {
    "resource": "https://mcp.example.com/mcp",
    "issuers": [
     "https://as.example.com"
    ],
    "tokenEndpoints": [
     "https://as.example.com/token"
    ]
   },
   "expect": {
    "verdict": "refuse",
    "code": "clock-not-configured"
   },
   "rationale": "a lifetime decision with no clock is not an admission"
  },
  {
   "id": "no-resource-configured",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "options": {
    "issuers": [
     "https://as.example.com"
    ],
    "tokenEndpoints": [
     "https://as.example.com/token"
    ],
    "now": 1800000000
   },
   "expect": {
    "verdict": "refuse",
    "code": "resource-not-configured"
   },
   "rationale": "an audience decision with no resource"
  },
  {
   "id": "no-issuers-configured",
   "text": "{\"header\":{\"typ\":\"at+jwt\",\"alg\":\"ES256\"},\"claims\":{\"iss\":\"https://as.example.com\",\"aud\":\"https://mcp.example.com/mcp\",\"sub\":\"user-1\",\"exp\":1800000600,\"iat\":1799999990},\"presentation\":\"bearer\"}",
   "options": {
    "resource": "https://mcp.example.com/mcp",
    "tokenEndpoints": [
     "https://as.example.com/token"
    ],
    "now": 1800000000
   },
   "expect": {
    "verdict": "refuse",
    "code": "issuers-not-configured"
   },
   "rationale": "an issuer decision with no advertised servers"
  }
 ]
}
