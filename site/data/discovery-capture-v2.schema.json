{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probityai.github.io/agent-evidence-atlas/data/discovery-capture-v2.schema.json",
  "title": "Private discovery receiver record; not study acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt",
    "sources",
    "journal_partial_tail",
    "events",
    "response",
    "contract",
    "native_closure",
    "driver_closure"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "task_id",
        "mode",
        "repetition",
        "suite_sha256"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^D[0-9]{2}$"
        },
        "mode": {
          "enum": [
            "navigation",
            "open_search"
          ]
        },
        "repetition": {
          "type": "integer",
          "minimum": 1
        },
        "suite_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation",
        "prompt",
        "driver_sources",
        "native_events",
        "stderr",
        "journal"
      ],
      "properties": {
        "invocation": {
          "$ref": "#/$defs/binding"
        },
        "prompt": {
          "$ref": "#/$defs/binding"
        },
        "driver_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "discovery_capture.py",
            "discovery_capture_journal.py"
          ],
          "properties": {
            "discovery_capture.py": {
              "$ref": "#/$defs/binding"
            },
            "discovery_capture_journal.py": {
              "$ref": "#/$defs/binding"
            }
          }
        },
        "native_events": {
          "$ref": "#/$defs/binding"
        },
        "stderr": {
          "$ref": "#/$defs/binding"
        },
        "journal": {
          "$ref": "#/$defs/binding"
        }
      }
    },
    "journal_partial_tail": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset",
          "length",
          "sha256",
          "parse_state",
          "event_type",
          "observation"
        ],
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "parse_state": {
            "enum": [
              "parsed",
              "invalid",
              "oversized",
              "incomplete"
            ]
          },
          "event_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "observation": {
            "anyOf": [
              {
                "$ref": "#/$defs/observation"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "captures"
      ],
      "properties": {
        "state": {
          "enum": [
            "absent",
            "observed",
            "multiple"
          ]
        },
        "captures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "event_offset",
              "sha256",
              "bytes",
              "observation"
            ],
            "properties": {
              "origin": {
                "const": "native_event_text"
              },
              "event_offset": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "observation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/observation"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "metadata",
        "selection",
        "refusal",
        "observation",
        "origin",
        "refusal_detail",
        "validator_sources"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_evaluated",
            "valid",
            "invalid"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/selection"
            },
            {
              "type": "null"
            }
          ]
        },
        "refusal": {
          "anyOf": [
            {
              "enum": [
                "invalid_json",
                "invalid_contract",
                "metadata_oversized"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "const": "supplied_metadata"
        },
        "refusal_detail": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16000
            },
            {
              "type": "null"
            }
          ]
        },
        "validator_sources": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "discovery_capture_v2.py",
                "discovery-capture-v2.schema.json"
              ],
              "properties": {
                "discovery_capture_v2.py": {
                  "$ref": "#/$defs/binding"
                },
                "discovery-capture-v2.schema.json": {
                  "$ref": "#/$defs/binding"
                }
              }
            }
          ]
        }
      }
    },
    "native_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "exit_code",
        "observation"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "exit_observed"
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "driver_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observation"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "completed",
            "interrupted"
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "observed_at",
        "monotonic_elapsed_ns",
        "receiver_clock_id"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+Z$"
        },
        "monotonic_elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "receiver_clock_id": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "profile_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "recipe_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "component_ids",
        "profile_ids",
        "recipe_url",
        "command"
      ]
    }
  }
}
