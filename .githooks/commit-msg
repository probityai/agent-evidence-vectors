def selftest() -> int:
    #: Every assertion below goes through `check`, so the tally at the end
    #: counts what actually ran. It previously reported `len(SELFTEST_CASES)`
    #: while the rule-surface assertions ran uncounted -- a gate that
    #: under-reports its own coverage is the same defect class as one that
    #: skips a rule silently, and this file's other comments say so.
    failures = 0
    checks = 0

    def check(passed: bool, message: str) -> None:
        nonlocal failures, checks
        checks += 1
        if not passed:
            failures += 1
            print(f"FAIL {message}", file=sys.stderr)

    def raises(call: object, *args: object) -> bool:
        try:
            call(*args)  # type: ignore[operator]
        except ValueError:
            return True
        return False

    # The extension point is a rule surface, so it gets tested like one.
    parsed = parse_extra_patterns(
        "# comment\n\n(?i)\\bwidget\\b\tproduct name\n", "<fixture>"
    )
    check(
        [e for e in lint("feat: ship the Widget", parsed) if "product name" in e] != [],
        "extra-patterns: loaded rule did not fire",
    )
    check(
        not lint("feat: ship the thing", parsed),
        "extra-patterns: loaded rule over-matched",
    )
    check(
        raises(parse_extra_patterns, "no-tab-here\n", "<fixture>"),
        "extra-patterns: malformed line was accepted",
    )

    # The hashed rule surface, tested the same way. The fixture salt and word
    # are local to this test, so the selftest never needs a real forbidden
    # word to prove the mechanism works.
    fixture_salt = "abcdef0123456789"
    fixture_word = "widget"
    fixture_digest = hashlib.sha256(
        (fixture_salt + fixture_word).encode("utf-8")
    ).hexdigest()
    hashed = parse_forbidden_words(
        f"# salt: {fixture_salt}\n# lengths-i: {len(fixture_word)}\n"
        f"{fixture_digest}\tproduct name\n",
        "<fixture>",
    )
    check(
        hashed
        == (fixture_salt, [len(fixture_word)], [], {fixture_digest: "product name"}),
        "forbidden-words: parse produced the wrong table",
    )

    # A case-SENSITIVE entry must not fire on the same letters in another case.
    # This is the property that keeps an all-caps marker from matching prose.
    cased_word = "NOTPOSTED"
    cased_digest = hashlib.sha256(
        (fixture_salt + cased_word).encode("utf-8")
    ).hexdigest()
    cased = parse_forbidden_words(
        f"# salt: {fixture_salt}\n# lengths-s: {len(cased_word)}\n"
        f"{cased_digest}\tmarker\n",
        "<fixture>",
    )
    check(
        [e for e in lint("feat: NOTPOSTED yet", None, cased) if "marker" in e] != [],
        "forbidden-words: case-sensitive entry did not fire on its exact form",
    )
    check(
        not [e for e in lint("feat: notposted yet", None, cased) if "marker" in e],
        "forbidden-words: case-sensitive entry fired on a different case",
    )

    # Fires on the bare word and on the word embedded in punctuation, a scope
    # and a hyphenated compound -- the shapes the tokenizer exists for.
    for probe in (
        "feat: ship the Widget",
        "feat: ship Widget, Inc. today",
        "feat: bump @widget/verify",
        "feat: bump widget-runtime",
        "feat: rename mywidgetthing",
    ):
        hits = [e for e in lint(probe, None, hashed) if "product name" in e]
        check(bool(hits), f"forbidden-words: no hit on {probe!r}")
        # The report must never echo what it caught, or the failure message
        # reproduces the string the rule exists to suppress.
        check(
            fixture_word not in " ".join(hits).lower(),
            f"forbidden-words: the error echoed the forbidden word for {probe!r}",
        )
    check(
        not lint("feat: ship the thing", None, hashed),
        "forbidden-words: rule over-matched",
    )
    # A forbidden word glued inside a longer identifier MUST fire. This is the
    # property that keeps the rule as wide as the case-insensitive substring
    # search it replaces; a tokenizing check would let it through.
    check(
        [e for e in lint("feat: ship the widgets", None, hashed) if "product name" in e] != [],
        "forbidden-words: missed the word inside a longer identifier",
    )
    # An absent sidecar means no rules, never a silent pass of a broken one.
    check(
        not lint("feat: ship the Widget", None, ("", [], [], {})),
        "forbidden-words: empty table still fired",
    )
    for bad_text, why in (
        (f"# salt: {fixture_salt}\n# lengths-i: 6\nnot-a-digest\tlabel\n", "non-digest accepted"),
        (f"# lengths-i: 6\n{fixture_digest}\tlabel\n", "digests with no salt accepted"),
        (f"# salt: {fixture_salt}\n{fixture_digest}\tlabel\n", "digests with no lengths accepted"),
        (f"# salt: {fixture_salt}\n# lengths-i: zero\n{fixture_digest}\tlabel\n", "non-numeric lengths accepted"),
        (f"# salt: {fixture_salt}\n", "salt with no digests accepted"),
        (f"# salt: SHOUTY\n# lengths-i: 6\n{fixture_digest}\tlabel\n", "non-hex salt accepted"),
        (f"# salt: {fixture_salt}\n# lengths-i: 6\n{fixture_digest} label\n", "missing tab accepted"),
        (
            f"# salt: {fixture_salt}\n# salt: {fixture_salt}\n# lengths-i: 6\n{fixture_digest}\tl\n",
            "duplicate salt accepted",
        ),
    ):
        check(
            raises(parse_forbidden_words, bad_text, "<fixture>"),
            f"forbidden-words: {why}",
        )

    # The permit surface. A permit is the one rule shape that can only ever
    # loosen, so every case below asserts a direction and the refusals outnumber
    # the permission. The fixture owner and the fixture forbidden word are local
    # to this test, so the selftest proves the mechanism without this file ever
    # carrying a real name -- which matters here, because this file is scanned by
    # the guard it implements.
    fixture_owner = "acmeorg"
    permits = parse_permitted_paths(
        f"# comment\n\n{fixture_owner.encode('ascii').hex()}\t/{fixture_word}-repo\\b\n",
        "<fixture>",
    )
    check(len(permits) == 1, "permitted-paths: parse produced the wrong number of permits")
    owned = f"feat: bump {fixture_owner}/{fixture_word}-repo"
    check(
        not [e for e in lint(owned, None, hashed, permits) if "product name" in e],
        "permitted-paths: an owner-qualified path was still refused",
    )
    # The same line with no permits must refuse, or the case above proves nothing
    # about the permit and only that the rule does not fire on this shape.
    check(
        [e for e in lint(owned, None, hashed) if "product name" in e] != [],
        "permitted-paths: the path passed with NO permit loaded, so the permit is not what allowed it",
    )
    for what, probe in (
        ("the bare name", f"feat: ship the {fixture_word}"),
        (
            "a second mention that is not owner-qualified",
            f"feat: bump {fixture_owner}/{fixture_word}-repo and the {fixture_word} runtime",
        ),
        (
            "a repository outside the permit",
            f"feat: bump {fixture_owner}/{fixture_word}-other",
        ),
    ):
        check(
            [e for e in lint(probe, None, hashed, permits) if "product name" in e] != [],
            f"permitted-paths: {what} passed, which widens the permit past a path",
        )
    for bad_permit, why in (
        (f"{fixture_owner.encode('ascii').hex()}\t/a\tlabel\n", "a third field accepted"),
        (f"{fixture_owner.encode('ascii').hex()}\n", "a line with no pattern accepted"),
        (f"{fixture_owner.encode('ascii').hex()}\t\n", "an empty pattern accepted"),
        ("nothex\t/a\n", "a non-hex first field accepted"),
        ("ff\t/a\n", "a non-ASCII hex field accepted"),
        (f"{fixture_owner.encode('ascii').hex()}\t/a(\n", "a pattern that does not compile accepted"),
    ):
        check(
            raises(parse_permitted_paths, bad_permit, "<fixture>"),
            f"permitted-paths: {why}",
        )

    for message, expected in SELFTEST_CASES:
        errors = lint(message)
        label = message.splitlines()[0][:58] if message.strip() else "<empty>"
        if expected is None:
            check(not errors, f"expected-pass: {label!r} -> {errors}")
        else:
            check(
                any(expected in error for error in errors),
                f"expected {expected!r}: {label!r} -> {errors}",
            )

    if failures:
        print(f"commit-msg selftest: {failures}/{checks} checks FAILED", file=sys.stderr)
        return 1
    print(f"commit-msg selftest: {checks}/{checks} checks passed")
    return 0


def check_range(rev_range: str) -> int:
    """Lint every commit message in a revision range (used by CI)."""
    extra = load_extra_patterns()
    forbidden = load_forbidden_words()
    permits = load_permitted_paths()
    baseline = load_baseline()
    # `^<baseline>` drops everything the baseline already reaches, which is what
    # makes the gate effective-from rather than retroactive. It is passed to the
    # same rev-list that resolves the range, so an unresolvable baseline fails
    # here rather than quietly widening or emptying the set.
    argv = ["git", "rev-list", rev_range]
    if baseline is not None:
        argv.append(f"^{baseline}")
    listed = subprocess.run(
        argv,
        capture_output=True,
        text=True,
        check=False,
    )
    if listed.returncode != 0:
        print(
            f"commit-msg: cannot resolve range {rev_range!r}: "
            f"{listed.stderr.strip()}",
            file=sys.stderr,
        )
        return 2
    revisions = listed.stdout.split()
    bad = 0
    for revision in revisions:
        shown = subprocess.run(
            ["git", "show", "-s", "--format=%B", revision],
            capture_output=True,
            check=True,
        )
        message = shown.stdout.decode("utf-8", errors="surrogateescape")
        errors = lint(message, extra, forbidden, permits)
        if errors:
            bad += 1
            report(errors, f"commit {revision[:12]}")
    scope = f" (from baseline {baseline[:12]})" if baseline is not None else ""
    print(
        f"commit-msg: checked {len(revisions)} commit message(s) in "
        f"{rev_range}{scope}; {bad} rejected"
    )
    return 1 if bad else 0


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("commit-msg: missing message-file path", file=sys.stderr)
        return 2
    if argv[1] == "--selftest":
        return selftest()
    if argv[1] == "--check-range":
        if len(argv) < 3:
            print("commit-msg: --check-range needs a revision range", file=sys.stderr)
            return 2
        return check_range(argv[2])

    path = Path(argv[1])
    try:
        message = read_message(path)
    except OSError as exc:
        print(f"commit-msg: cannot read {path}: {exc}", file=sys.stderr)
        return 2
    errors = lint(
        message, load_extra_patterns(), load_forbidden_words(), load_permitted_paths()
    )
    if errors:
        report(errors, "the commit message")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
