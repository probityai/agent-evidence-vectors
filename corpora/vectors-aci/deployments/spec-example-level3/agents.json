{
  "manifest_version": "0.9.0",
  "last_updated": "2026-07-19",
  "publisher": "NovaDynamics Inc.",
  "agents": [
    {
      "id": "novadynamics.nexus-bot",
      "name": "NexusBot",
      "type": "operations-agent",
      "description": "Autonomous incident response and infrastructure optimization agent.",
      "capabilities": ["incident-detection", "root-cause-analysis", "auto-remediation", "resource-optimization"],
      "interface": {
        "type": "api",
        "protocol": "https",
        "integration-model": "webhook-api"
      },
      "authentication": "api-key",
      "endpoints": [
        {
          "name": "incident-webhook",
          "url": "https://api.novadynamics.example/v1/nexus/incidents",
          "method": "POST"
        },
        {
          "name": "status-query",
          "url": "https://api.novadynamics.example/v1/nexus/status",
          "method": "GET"
        }
      ],
      "status": "active"
    },
    {
      "id": "novadynamics.skyhook-api",
      "name": "SkyHook API Agent",
      "type": "infrastructure-agent",
      "description": "Declarative cloud orchestration agent for infrastructure management.",
      "capabilities": ["deploy", "scale", "monitor", "optimize"],
      "interface": {
        "type": "api",
        "protocol": "https",
        "integration-model": "rest-api"
      },
      "authentication": "oauth2",
      "endpoints": [
        {
          "name": "deploy",
          "url": "https://api.novadynamics.example/v1/skyhook/deploy",
          "method": "POST"
        },
        {
          "name": "status",
          "url": "https://api.novadynamics.example/v1/skyhook/status",
          "method": "GET"
        }
      ],
      "status": "active"
    }
  ],
  "discovery": {
    "llms-txt": "https://novadynamics.example/llms.txt",
    "identity-manifest": "https://novadynamics.example/identity.json",
    "capability-manifest": "https://novadynamics.example/capabilities.json",
    "knowledge-graph": "https://novadynamics.example/knowledge.json",
    "trust-manifest": "https://novadynamics.example/trust.json"
  },
  "authentication": {
    "type": "api-key-or-oauth2",
    "details": "Contact contact@novadynamics.example for API credentials."
  }
}
