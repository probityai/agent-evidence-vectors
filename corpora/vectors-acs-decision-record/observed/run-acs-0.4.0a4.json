  "manifest": "agent_control_specification_version: \"0.4.0-alpha.1\"\nmetadata:\n  name: decision-record-run\npolicies:\n  tool_gate:\n    type: rego\n    bundle: ./policy\n    query: data.tool_gate.verdict\ntools:\n  read_file: {}\n  delete_branch: {}\n  send_payment: {}\nintervention_points:\n  pre_tool_call:\n    policy_target: \"$.tool_call.args\"\n    policy_target_kind: tool_args\n    tool_name_from: \"$.tool_call.name\"\n    policy:\n      id: tool_gate\n",
