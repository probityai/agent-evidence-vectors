  "specification": {
    "scope": "What an MCP server publishes about its OAuth protection, read from outside: Protected Resource Metadata (RFC 9728), Authorization Server metadata (RFC 8414), the Bearer challenge on a request with no token (RFC 6750 section 3), the server's authorization settings, and whether a request with no token, or with a token that lacks a required scope, is refused. It also covers four extension surfaces: a DPoP proof and its binding to the token, a workload identity token exchanged for scopes, an OAuth Client ID Metadata Document, and an identity assertion authorization grant. JWTs are carried decoded; signatures are outside this corpus. All fixtures are synthetic.",
    "sources": [
      "RFC 9728 OAuth 2.0 Protected Resource Metadata",
      "RFC 8414 OAuth 2.0 Authorization Server Metadata",
      "RFC 6750 Bearer Token Usage, section 3",
      "RFC 9449 OAuth 2.0 Demonstrating Proof of Possession (DPoP)",
      "MCP specification, Authorization"
    ],
    "status": "proposal of this repository, not a vendored upstream text",
    "verifierContract": "verifier <observation file>: the last stdout line is one JSON object with `verdict` (valid or invalid) and `codes` (the finding codes, a set); exit 0 for valid, 1 for invalid."
  },
  "suite": "mcp-authz-observation/v1",
