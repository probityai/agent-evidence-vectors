export UV_PYTHON=3.13
rc=0
step() { echo "STEP $1"; shift; "$@" || { echo "STEPFAIL $?"; rc=1; }; }
step regen uv run --locked --extra generators python scripts/regenerate-derived.py
step pytest uv run --locked --extra dev python -m pytest corpora/vectors-uncertain-effect/tests -q -x -p no:cacheprovider
step gotest go test ./corpusreaders/... -run 'UncertainEffect|Uncertain' -count=1
step mypy uv run --locked --extra dev python -m mypy packaging/agent_evidence_vectors/uncertaineffect.py packaging/agent_evidence_vectors/uncertaineffect_runtime.py corpora/vectors-uncertain-effect/tests/runtime_adapter.py
step ruff uv run --locked --extra dev python -m ruff check packaging corpora/vectors-uncertain-effect
git add -N . && git diff -- release interop > release/.regen.patch
echo "B06DONE rc=$rc"
exit $rc
