  "conditions": {
    "adm-c-1": {
      "file": "spec/predicates/adversarial-execution-evidence.md",
      "quote": "A consumer MUST pin, out of band, the corpus digest and the substrate digest it expects for the deployment it is admitting into",
      "requires": "A statement is admitted only when the consumer has pinned the corpus, the substrate and the subject digest it expects, or has declined the pins by name. Silence is not a decline."
    },
    "adm-c-2": {
      "file": "spec/predicates/adversarial-execution-evidence.md",
      "quote": "A consumer that demands no class MUST record that decision explicitly rather than reach it by omission",
      "requires": "A statement is admitted only when the consumer has pinned the classes it demands and every one is assessed, or has declined the demand by name."
    },
    "adm-c-3": {
      "file": "spec/predicates/adversarial-execution-evidence.md",
      "quote": "A consumer with no policy-pinned substrate root MUST treat every `basis: substrate` row as `unattested`",
      "requires": "A substrate row is credited only when its covering records verify under a key the consumer pinned, so a consumer that pinned none admits no substrate row."
    },
    "adm-c-4": {
      "file": "spec/v1/statement.md",
      "quote": "A verifier admitting a statement matches the subject by `subject[0].digest.sha256` and by nothing else",
      "requires": "The subject is matched by the sha256 digest the observer's records bind, never by its name, which no observer signs."
    },
    "adm-c-5": {
      "file": "spec/predicates/adversarial-execution-evidence.md",
      "quote": "`issuedAt` is producer-asserted, sits outside every substrate signature, and is not among the run binding digest's inputs",
      "requires": "A bound on when a run happened is evaluated against the armedAt a verified arming record carries, never against issuedAt, and a bounded consumer handed no such record refuses."
    },
    "adm-c-6": {
      "file": "spec/predicates/adversarial-execution-evidence.md",
      "quote": "a policy relaxed to admit `pass_indirect` MUST keep the rule",
      "requires": "Only the result tokens the consumer accepts are admitted: `pass` by default, `pass` and `pass_indirect` when widened, and nothing else."
    },
    "adm-c-7": {
      "file": "spec/predicates/adversarial-execution-evidence.md",
      "quote": "an admission rule that needs a live observation keys on `method: intercepted` as well as the tier",
      "requires": "A clean row is admitted only as a live substrate interception unless the consumer declines that obligation by name, under a threshold that makes the decline reachable."
    }
  },
